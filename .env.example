# Copy to .env for local use. On Replit, add these under Tools > Secrets instead.
# Never commit real keys.

# Primary AI (Groq, model: openai/gpt-oss-120b)
GROQ_API_KEY=

# Fallback AI (NVIDIA, model: meta/muse-glimmer-30b). Used when Groq is missing or fails.
NVIDIA_API_KEY=

# --- Optional ---
# Names that call Cleo in a group (comma-separated, case-insensitive). Default: cleo
# CLEO_BOT_NAMES=cleo
# Also answer when someone replies directly to one of Cleo's messages. Default: false
# CLEO_REPLY_TRIGGER=false
# Override the models
# GROQ_MODEL=openai/gpt-oss-120b
# NVIDIA_MODEL=meta/muse-glimmer-30b
# Where the WhatsApp login and chat history are stored (use a persistent volume in production)
# CLEO_AUTH_DIR=data/cleo-auth
# CLEO_SESSION_FILE=data/cleo-sessions.json
# Use a different knowledge base file
# CLEO_KNOWLEDGE_FILE=artifacts/api-server/knowledge/candidate-knowledge-base.md
